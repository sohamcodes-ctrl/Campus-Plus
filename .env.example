# ==============================================================================
# CAMPUS PLUS — ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - DO NOT commit real secrets, API keys, or service role credentials to Git.
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser client bundle.
# - Variables WITHOUT NEXT_PUBLIC_ are strictly server-only.
# ==============================================================================

# Application Runtime
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Logging & Observability
LOG_LEVEL="info"

# Security & Secrets (Server-Only)
# Must be 32+ character random strings in production
APP_SECRET="dummy_app_secret_change_in_production_min_32_chars"
CRON_SECRET="dummy_cron_secret_change_in_production"

# Supabase / Persistence Configuration (Server & Client Boundaries)
# In Phase 03, these are validated configuration placeholders only.
# No active external connections or queries are executed during Phase 03.
NEXT_PUBLIC_SUPABASE_URL="https://placeholder-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_template_only"
SUPABASE_SERVICE_ROLE_KEY="dummy_service_role_key_for_server_only_do_not_expose"
SUPABASE_JWT_SECRET="dummy_jwt_secret_must_be_kept_confidential_on_server"

# Storage / S3 / Bucket (Future phases)
STORAGE_BUCKET_ATTACHMENTS="campus-plus-attachments"
STORAGE_MAX_FILE_SIZE_BYTES="10485760"
